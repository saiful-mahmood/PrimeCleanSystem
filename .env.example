# ============================================================
# CleanOps environment variables
# Copy to .env.local and fill in:  cp .env.example .env.local
# Never commit .env.local — it is gitignored.
# "Needed from" tells you which session in docs/PROMPTS.md first uses it.
# ============================================================

# ------------------------------------------------------------
# App  (Session 0)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUSINESS_TZ=America/New_York
# The one email allowed to log in as owner (Supabase magic link).
OWNER_EMAIL=

# ------------------------------------------------------------
# Supabase  (Session 0)  https://supabase.com → Project → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (route handlers, cron, webhooks, MCP). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for before/after photos.
SUPABASE_PHOTOS_BUCKET=job-photos

# ------------------------------------------------------------
# Lockbox encryption  (Session 1)
# Generate once:  openssl rand -base64 32   — losing it means re-entering codes.
# ------------------------------------------------------------
LOCKBOX_ENC_KEY=

# ------------------------------------------------------------
# Cron  (Session 2 onward)  Any long random string; Vercel cron sends it as a bearer token.
# ------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------
# Stripe  (Session 4)  https://dashboard.stripe.com → Developers → API keys
# Use TEST mode keys until the owner says otherwise.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or Developers → Webhooks in the dashboard.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Messaging  (Session 5)
# MESSAGING_PROVIDER=email until Twilio A2P 10DLC registration is approved.
# ------------------------------------------------------------
MESSAGING_PROVIDER=email

# Twilio  https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (email fallback)  https://resend.com → API Keys. Verify your sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Owner's Zelle handle shown in "Zelle requested" messages.
OWNER_ZELLE_HANDLE=

# ------------------------------------------------------------
# Anthropic API — proposal generation  (Session 6)  https://console.anthropic.com
# Pay-as-you-go key, separate from the Claude subscription.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
PROPOSAL_MODEL=claude-opus-5-5

# ------------------------------------------------------------
# Google Sheets nightly sync  (Session 8, optional)
# Service account JSON (single line) with edit access to the sheet.
# ------------------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
